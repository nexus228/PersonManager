<Window x:Class="PersonManager_WPF_CLIENT.View.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonManager_WPF_CLIENT.View"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="DetailsWindow" Height="450" Width="800">
    <Grid>

        <ScrollViewer>
            
       
        <StackPanel Orientation="Vertical">

            <Label Content="{Binding DisplayName}" ContentStringFormat="Details zu: {0}" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="24" Margin="0,20,0,0"/>


            <StackPanel Margin="20">

                <!-- Adressen -->
                <Expander Header="Adressen"
      IsExpanded="True"
      Margin="0,0,0,10">

                    <ListView ItemsSource="{Binding Addresses}"
          BorderThickness="0">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">

                                    <Grid.ColumnDefinitions>
                                       <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                 

                                    <TextBlock Grid.Column="0">
                    <Run Text="{Binding Street}"/>
                    <Run Text="{Binding HouseNumber}"/>
                    <Run Text=","/>
                    <Run Text="{Binding ZipCode}"/>
                    <Run Text="{Binding City}"/>
                                    </TextBlock>

                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </Expander>


                <!-- Telefonnummern -->
                <Expander Header="Telefonnummern"
      IsExpanded="True">

                    <ListView ItemsSource="{Binding PhoneNumbers}"
          BorderThickness="0">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                           Text="{Binding PhoneNumber}"/>

                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                    </ListView>

                </Expander>

            </StackPanel>


        </StackPanel>
        </ScrollViewer>



    </Grid>
</Window>
