<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="String_WelcomeMessage">Hello</system:String>

    <system:String x:Key="String_LoadPerson">Personen laden</system:String>

    <system:String x:Key="String_ClearList">Liste leeren</system:String>

    <system:String x:Key="String_SearchPersonForName">Suche eine Person anhand des Vornamens oder Nachnamens:</system:String>
    
